# Copy to .env for local Docker development. Keep real secrets out of git.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-development-secret
API_HOST=0.0.0.0
API_PORT=8000
# Host port for Docker publishing. Keep 8000 unless another local app is already using it.
API_PUBLISHED_PORT=8000

DATABASE_URL=postgresql+psycopg://agentpulse:agentpulse_dev_password@postgres:5432/agentpulse
REDIS_URL=redis://redis:6379/0

# Comma-separated browser origins that may send credentialed requests.
# If API_PUBLISHED_PORT is not 8000, add that exact API origin to TRUSTED_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Cookie behavior. Use false only for explicit localhost HTTP development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800

# Rate limits use Redis and are per key/window.
LOGIN_RATE_LIMIT=10
INGEST_RATE_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=60

# Metrics cache lab. Keep disabled for baseline frontend measurements.
METRICS_CACHE_ENABLED=false
METRICS_CACHE_TTL_SECONDS=30

# Large browser worker experiment endpoint.
EXPERIMENTS_ENABLED=false
EXPERIMENT_MAX_RECORDS=50000

# Bootstrap command reads these values and creates or updates one user.
INITIAL_USER_EMAIL=admin@example.test
INITIAL_USER_PASSWORD=replace-before-running-bootstrap
INITIAL_USER_ROLE=admin

# Synthetic data and optional simulator.
SEED_RANDOM_SEED=20261011
SEED_SESSION_COUNT=50000
SIMULATOR_ENABLED=false
SIMULATOR_RATE_PER_MINUTE=30
SIMULATOR_SCENARIO=normal

